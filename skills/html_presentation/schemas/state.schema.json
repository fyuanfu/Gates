            "status": {
              "enum": [
                "not_started",
                "in_progress",
                "awaiting_approval",
                "approved",
                "rejected",
                "stale",
                "failed"
              ]
            },
            "gate": {
              "enum": [
                "G1",
                "G2",
                "G3",
                "G4",
                "G5"
              ]
            },
            "submitted_digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "approved_digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "last_error": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "status",
            "gate",
            "submitted_digest",
            "approved_digest",
            "last_error"
          ],
          "additionalProperties": false
