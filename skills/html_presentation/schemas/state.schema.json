              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "approved_digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "last_error": {
              "type": [
                "string",
                "null"
              ]
