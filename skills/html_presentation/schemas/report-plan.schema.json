{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/report-engineering/v1.1/report-plan.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S-[0-9]{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "context",
              "problem",
              "evidence",
              "recommendation",
              "implementation",
              "conclusion"
            ]
          },
          "key_message": {
            "type": "string",
            "minLength": 1
          },
          "claim_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C-[0-9]{3,}$"
            }
          },
          "content_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
          },
          "visual_intent": {
            "enum": [
              "text",
              "comparison",
              "chart",
              "process",
              "architecture",
              "table"
            ]
          },
          "covers": {
            "type": "array",
            "items": {
              "enum": [
                "desired_outcome",
                "desired_action",
                "core_thesis",
                "risk_limitations"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "role",
          "key_message",
          "claim_refs",
          "content_path",
          "visual_intent",
          "covers"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "sections"
  ],
  "additionalProperties": false
}
