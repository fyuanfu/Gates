{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/report-engineering/v1.1/skills-lock.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_uri": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "installation_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
          },
          "invocation_method": {
            "type": "string",
            "minLength": 1
          },
          "required_tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "input_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
            }
          },
          "output_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
            }
          },
          "smoke_fixture": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
          },
          "status": {
            "enum": [
              "candidate",
              "ready",
              "blocked"
            ]
          },
          "smoke_result_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "source_uri",
          "revision",
          "license",
          "installation_path",
          "invocation_method",
          "required_tools",
          "input_artifacts",
          "output_artifacts",
          "smoke_fixture",
          "status",
          "smoke_result_path"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "revision": {
                  "type": "string",
                  "minLength": 7
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                },
                "smoke_result_path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "skills"
  ],
  "additionalProperties": false
}
