{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/report-engineering/v1.1/sources-manifest.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-[0-9]{3,}$"
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "local",
              "web",
              "pasted"
            ]
          },
          "raw_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
          },
          "snapshot_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![a-zA-Z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
          },
          "original_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "extraction_status": {
            "enum": [
              "ok",
              "partial",
              "failed"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "classification": {
            "enum": [
              "public",
              "internal"
            ]
          }
        },
        "required": [
          "id",
          "origin",
          "kind",
          "raw_path",
          "snapshot_path",
          "original_sha256",
          "snapshot_sha256",
          "extraction_status",
          "retrieved_at",
          "classification"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false
}
